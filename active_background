<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>반응형 배경 예제</title>
    <style>
        .bg-container {
            width: 100%;
            height: 400px;
            /* 배경 이미지 설정 */
            background-image: url('/api/placeholder');
            /* 반복 없음 */
            background-repeat: no-repeat;
            /* 중앙 정렬 */
            background-position: center;
            /* 컨테이너에 맞게 크기 조절 */
            background-size: cover;
            /* 축약형 */
            /* background: url('/api/placeholder/800/400') no-repeat center/cover; */
        }

        /* 반응형 디자인 */
        @media (max-width: 768px) {
            .bg-container {
                height: 300px;
                background-size: contain;
            }
        }
    </style>
</head>
<body>
    <div class="bg-container"></div>
</body>
</html>